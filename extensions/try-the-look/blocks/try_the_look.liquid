  .vtl-result-title { font-family: 'Poppins', -apple-system, sans-serif; font-size: 14px; font-weight: 800; color: #fff; }
  .vtl-result-sub { font-family: 'Poppins', -apple-system, sans-serif; font-size: 10px; color: rgba(255,255,255,0.6); margin-top: 1px; }
  .vtl-result-header-close { width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,0.15); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; color: #fff; cursor: pointer; }
  .vtl-result-image-area { flex: 1; background: linear-gradient(140deg, #1a2840, #0d1a2e); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; min-height: 320px; }
  .vtl-result-img { width: 100%; height: 100%; object-fit: contain; display: block; animation: vtl-sharp-reveal 1.5s cubic-bezier(0.25,0,0.2,1) forwards; }
  @keyframes vtl-sharp-reveal { 0% { filter: blur(18px); opacity: 0.2; transform: scale(1.04); } 50% { filter: blur(6px); opacity: 0.7; } 100% { filter: blur(0px); opacity: 1; transform: scale(1); } }
  .vtl-result-pip { position: absolute; bottom: 12px; right: 12px; width: 64px; height: 80px; border-radius: 12px; background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 2px solid rgba(255,255,255,0.2); overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.3); }
  .vtl-pip-img { width: 100%; height: 100%; object-fit: cover; }
  .vtl-result-sheet { background: #fff; border-radius: 24px 24px 0 0; padding: 14px 18px 20px; flex-shrink: 0; }
  .vtl-result-sheet-handle { width: 36px; height: 3px; background: var(--vtl-border); border-radius: 3px; margin: 0 auto 12px; }
  .vtl-result-product-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .vtl-rpr-name { font-family: 'Poppins', -apple-system, sans-serif; font-size: 14px; font-weight: 800; color: #111; }
  .vtl-result-actions { display: flex; gap: 8px; margin-bottom: 12px; }
  .vtl-ra-btn-primary { flex: 1; background: var(--vtl-atc-btn-bg); color: var(--vtl-atc-btn-color); border: none; border-radius: 12px; padding: 13px; font-family: 'Poppins', -apple-system, sans-serif; font-size: 13px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; transition: all 0.2s; }
  .vtl-ra-btn-primary:hover { background: color-mix(in srgb, var(--vtl-atc-btn-bg) 85%, black); }
  .vtl-ra-btn-icon { width: 44px; height: 44px; background: var(--vtl-gray); border: 1px solid var(--vtl-border); border-radius: 12px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--vtl-navy); text-decoration: none; transition: all 0.2s; }
  .vtl-ra-btn-icon:hover { background: #eee; }
  .vtl-result-feedback { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .vtl-rf-label { font-family: 'Poppins', -apple-system, sans-serif; font-size: 11px; color: var(--vtl-muted); font-weight: 500; }
  .vtl-rf-btns { display: flex; gap: 8px; }
