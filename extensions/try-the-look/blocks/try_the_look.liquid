  .vtl-check-row { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 12px; margin-bottom: 6px; transition: all 0.3s; border: 1px solid transparent; }
  .vtl-check-row.done { background: var(--vtl-green-bg); border-color: rgba(5,150,105,0.15); }
  .vtl-check-row.active { background: var(--vtl-mint); border-color: rgba(0,128,96,0.2); }
  .vtl-check-row.pending { background: #f8f9fa; border-color: var(--vtl-border); }
  .vtl-cr-icon { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all 0.3s; color: var(--vtl-muted); }
  .vtl-check-row.done .vtl-cr-icon { background: var(--vtl-green); color: #fff; }
  .vtl-check-row.active .vtl-cr-icon { background: transparent; border: 2px solid var(--vtl-teal); color: var(--vtl-teal); animation: vtl-ring-spin 1s linear infinite; }
  .vtl-check-row.pending .vtl-cr-icon { background: var(--vtl-border); color: var(--vtl-muted); }
  @keyframes vtl-ring-spin { 0% { box-shadow: 2px 0 0 0 var(--vtl-teal); } 25% { box-shadow: 0 2px 0 0 var(--vtl-teal); } 50% { box-shadow: -2px 0 0 0 var(--vtl-teal); } 75% { box-shadow: 0 -2px 0 0 var(--vtl-teal); } 100% { box-shadow: 2px 0 0 0 var(--vtl-teal); } }
