  .vtl-rf-btn:hover { border-color: var(--vtl-teal); color: var(--vtl-teal); }
  .vtl-rf-good:hover { background: var(--vtl-green-bg); border-color: var(--vtl-green); color: var(--vtl-green); }
  .vtl-rf-retry { font-family: 'Poppins', -apple-system, sans-serif; font-size: 11px; font-weight: 600; color: var(--vtl-muted); background: none; border: none; cursor: pointer; padding: 4px; }
  .vtl-rf-retry:hover { color: var(--vtl-navy); }
  .vtl-status-msg { position: absolute; bottom: 16px; left: 20px; right: 20px; padding: 12px 16px; border-radius: 12px; font-family: 'Poppins', -apple-system, sans-serif; font-size: 13px; font-weight: 500; display: none; z-index: 30; }
  .vtl-status-msg.success { display: block; background: #d4edda; color: #155724; }
  .vtl-status-msg.error { display: block; background: #f8d7da; color: #721c24; }
</style>

<!-- SBB Prompts — loaded before main script -->
<script src="{{ 'prompts.js' | asset_url }}"></script>

<script>
  // ── Shop categories fetched from backend at init ──
  let sbbShopCategories = []; // filled by fetchAndApplySettings

  let selectedImageFile = null;
  let userImageDataURL = null;
  let generationStartTime = 0;
  let tipInterval = null;
  let screenTimers = [];
  let currentRequestPromise = null;

  const TIPS = [
    'Use a full body photo for best results',
    'Stand straight with arms slightly away from your body',
    'Avoid extreme angles — a straight-on mirror selfie works best',
    'Good lighting helps the AI match colours accurately',
    'Make sure your full torso is visible in the photo',
  ];

  function generateUUID() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
      const r = Math.random() * 16 | 0;
      const v = c === 'x' ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  }

  function getSessionId() {
    let sessionId = localStorage.getItem('sbb_session_id');
    if (!sessionId) {
      sessionId = generateUUID();
      localStorage.setItem('sbb_session_id', sessionId);
    }
    return sessionId;
  }

  function openVTLPopup() {
    const popup = document.getElementById('vtl-popup');
    if (popup) {
      if (popup.parentNode !== document.body) document.body.appendChild(popup);
      popup.classList.add('active');
      document.body.style.overflow = 'hidden';
      resetForm();
    }
  }
  // Assign immediately so onclick="openVTLPopup()" works as soon as script parses
  window.openVTLPopup = openVTLPopup;

  function closeVTLPopup(event) {
    if (event && event.target && !event.target.classList.contains('vtl-overlay')) return;
    closeVTLPopupDirect();
  }

  function closeVTLPopupDirect() {
    const popup = document.getElementById('vtl-popup');
    if (popup) {
      popup.classList.remove('active');
      document.body.style.overflow = '';
      clearAllTimers();
      resetForm();
    }
  }

  function goBackFromResult() {
    resetAndGoBack();
  }

  function resetAndGoBack() {
    clearAllTimers();
    resetForm();
  }

  function setVTLScreen(n) {
    document.querySelectorAll('.vtl-screen').forEach((s) => s.classList.remove('active'));
    const screen = document.getElementById('vtl-s' + n);
    if (screen) screen.classList.add('active');

    const titles = ['Try The Look', 'Try The Look', 'Try The Look', 'Try The Look', 'Try The Look', 'Your Try-On'];
    const subs = ['See how it looks on you', 'Analysing your photo...', 'Reading product details...', 'Placing it on you...', 'Finalizing the look...', 'Results'];
    const titleEl = document.getElementById('vtl-header-title');
    const subEl = document.getElementById('vtl-header-sub');
    if (titleEl) titleEl.textContent = titles[n];
    if (subEl) subEl.textContent = subs[n];

    const backBtn = document.getElementById('vtl-back-btn');
    if (backBtn) {
      if (n === 5) backBtn.classList.add('visible');
      else backBtn.classList.remove('visible');
    }

    if (n === 1) startTipRotation('vtl-tip-text-1');
    else if (n === 2) startTipRotation('vtl-tip-text-2');
    else if (n === 3) startTipRotation('vtl-tip-text-3');
    else stopTipRotation();

    if (n === 4) runChecklist();
  }

  function handleVTLUpload(event) {
    const file = event.target.files[0];
    if (file && file.type.startsWith('image/')) {
      selectedImageFile = file;
      const reader = new FileReader();
      reader.onload = function (e) {
        userImageDataURL = e.target.result;
        document.getElementById('vtl-preview-img').src = userImageDataURL;
        document.getElementById('vtl-preview-name').textContent = file.name;
        document.getElementById('vtl-preview-wrap').style.display = 'block';
        document.getElementById('vtl-upload-btn').style.display = 'none';
        document.getElementById('vtl-generate-actions').style.display = 'block';
        document.querySelector('.vtl-upload-tips').style.display = 'none';
      };
      reader.readAsDataURL(file);
    } else {
      showVTLStatus('Please select a valid image file', 'error');
    }
  }

  function removeVTLImage(event) {
    if (event) event.stopPropagation();
    selectedImageFile = null;
    userImageDataURL = null;
    currentRequestPromise = null;
    document.getElementById('vtl-preview-wrap').style.display = 'none';
    document.getElementById('vtl-preview-img').src = '';
    document.getElementById('vtl-preview-name').textContent = '';
    document.getElementById('vtl-file-input').value = '';
    document.getElementById('vtl-upload-btn').style.display = 'flex';
    document.getElementById('vtl-generate-actions').style.display = 'none';
    document.querySelector('.vtl-upload-tips').style.display = 'block';
    hideVTLStatus();
  }

  function setCardImages() {
    const productImageUrl = "{{ current_product.featured_image | image_url: width: 300 }}";
    ['1', '2', '3', '4'].forEach((s) => {
      const prodImg = document.getElementById('vtl-card-product-img-' + s);
      const userImg = document.getElementById('vtl-card-user-img-' + s);
      if (prodImg) prodImg.src = productImageUrl;
      if (userImg && userImageDataURL) userImg.src = userImageDataURL;
    });
  }

  function animateProgress(fillId, pctId, startPct, endPct) {
    const fill = document.getElementById(fillId);
    const pct = document.getElementById(pctId);
    if (!fill) return;
    let p = startPct;
    const iv = setInterval(() => {
      p = Math.min(p + Math.random() * 2.5, endPct);
      fill.style.width = p + '%';
      if (pct) pct.textContent = Math.round(p) + '%';
      if (p >= endPct) clearInterval(iv);
    }, 400);
  }

  function startTipRotation(elId) {
    stopTipRotation();
    let tipIdx = 0;
    const tipEl = document.getElementById(elId);
    if (tipEl) tipEl.textContent = TIPS[0];
    tipInterval = setInterval(() => {
      tipIdx = (tipIdx + 1) % TIPS.length;
      const te = document.getElementById(elId);
      if (te) {
        te.style.opacity = '0';
        setTimeout(() => {
          te.textContent = TIPS[tipIdx];
          te.style.opacity = '1';
        }, 300);
      }
    }, 3500);
  }

  function stopTipRotation() {
    if (tipInterval) {
      clearInterval(tipInterval);
      tipInterval = null;
    }
  }

  function runChecklist() {
    const rows = ['vtl-cr1', 'vtl-cr2', 'vtl-cr3', 'vtl-cr4'];
    const fillEl = document.getElementById('vtl-prog-fill-4');
    const pctEl = document.getElementById('vtl-prog-pct-4');

    rows.forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        el.classList.remove('done', 'active');
        el.classList.add('pending');
      }
    });

    const cr1 = document.getElementById('vtl-cr1');
    if (cr1) { cr1.classList.remove('pending'); cr1.classList.add('done'); }
    const cr2 = document.getElementById('vtl-cr2');
    if (cr2) { cr2.classList.remove('pending'); cr2.classList.add('active'); }

    if (fillEl) fillEl.style.width = '82%';
    if (pctEl) pctEl.textContent = '82%';

    const delays = [2000, 4000, 6000];
    delays.forEach((delay, idx) => {
      const t = setTimeout(() => {
        const curId = rows[idx + 1];
        const cur = document.getElementById(curId);
        if (cur) { cur.classList.remove('active'); cur.classList.add('done'); }

        const nextId = rows[idx + 2];
        const next = document.getElementById(nextId);
        if (next) { next.classList.remove('pending'); next.classList.add('active'); }

        const pcts = [88, 93, 97];
        if (fillEl) fillEl.style.width = pcts[idx] + '%';
        if (pctEl) pctEl.textContent = pcts[idx] + '%';

        if (idx === delays.length - 1) {
          const t2 = setTimeout(() => {
            const last = document.getElementById(rows[3]);
            if (last) { last.classList.remove('active'); last.classList.add('done'); }
            if (fillEl) fillEl.style.width = '100%';
            if (pctEl) pctEl.textContent = '100%';
          }, 1500);
          screenTimers.push(t2);
        }
      }, delay);
      screenTimers.push(t);
    });
  }

  async function onGenerateClick() {
    if (!selectedImageFile) {
      showVTLStatus('Please select an image first', 'error');
      return;
    }

    document.getElementById('vtl-preview-wrap').style.display = 'none';
    document.getElementById('vtl-generate-actions').style.display = 'none';
    document.getElementById('vtl-uploading-state').style.display = 'flex';
    document.querySelector('.vtl-ready-label').style.display = 'none';
    document.querySelector('.vtl-product-strip').style.display = 'none';

    generationStartTime = Date.now();
    currentRequestPromise = sendGenerationRequest();

    const t1 = setTimeout(() => {
      document.getElementById('vtl-uploading-state').style.display = 'none';
      setVTLScreen(1);
      setCardImages();
      animateProgress('vtl-prog-fill-1', 'vtl-prog-pct-1', 0, 32);
    }, 1200);
    screenTimers.push(t1);

    const t2 = setTimeout(() => setVTLScreen(2), 4500);
    const t3 = setTimeout(() => setVTLScreen(3), 8000);
    const t4 = setTimeout(() => setVTLScreen(4), 11500);
    screenTimers.push(t2, t3, t4);

    try {
      const result = await currentRequestPromise;
      clearAllTimers();
      showResult(result);
    } catch (error) {
      clearAllTimers();
      showVTLStatus('Failed to generate image. Please try again.', 'error');
      setTimeout(() => {
        setVTLScreen(0);
        resetForm();
      }, 2000);
    }
  }

  async function sendGenerationRequest() {
    const productTitle = "{{ current_product.title | escape }}";
    const productDescription = "{{ current_product.description | strip_html | escape }}";
    const productImageUrl = "{{ current_product.featured_image | image_url: width: 1024 }}";
    const shopDomain = window.Shopify?.shop || 'see-before-buy-ai.myshopify.com';
    const sessionId = getSessionId();

    // ── Detect prompt using prompts.js ──────────────────────────────────────
    const promptText = (window.SBB_PROMPTS && window.SBB_PROMPTS.detectPrompt)
      ? window.SBB_PROMPTS.detectPrompt(productTitle, productDescription, sbbShopCategories)
      : null; // fallback to backend-side prompt if JS not loaded yet

    const formData = new FormData();
    formData.append('userImage', selectedImageFile);
    formData.append('shop_domain', shopDomain);
    formData.append('product_name', productTitle);
    formData.append('product_title', productTitle);
    formData.append('product_description', productDescription);
    formData.append('session_id', sessionId);
    if (promptText) formData.append('custom_prompt', promptText); // send detected prompt
    if (productImageUrl) formData.append('product_image_url', productImageUrl);

    const response = await fetch('https://seebeforebuy.in/api/generate-image', {
      method: 'POST',
      body: formData,
    });

    const data = await response.json();
    if (!response.ok || !data.success) {
      throw new Error(data.message || data.error || 'Image generation failed');
    }

    return data.generated_image_url;
  }

  function showResult(imageUrl) {
    const elapsed = Math.round((Date.now() - generationStartTime) / 1000);
    const resultImage = document.getElementById('vtl-result-image');
    const downloadLink = document.getElementById('vtl-download-btn');
    if (resultImage) resultImage.src = imageUrl;
    if (downloadLink) downloadLink.href = imageUrl;
    const timerEl = document.getElementById('vtl-result-timer');
    if (timerEl) timerEl.textContent = 'Generated in ' + elapsed + ' seconds';
    setVTLScreen(5);
  }

  async function addToCart() {
    const variantId = "{{ default_variant.id }}";
    const btn = document.getElementById('vtl-add-to-cart-btn');
    if (!variantId || !btn) return;
    const orig = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = 'Adding...';

    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: parseInt(variantId, 10), quantity: 1 }] }),
      });
      if (!response.ok) throw new Error('Failed');
      btn.innerHTML = '✓ Added to Cart!';
      btn.style.background = '#059669';
      document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
      setTimeout(() => { window.location.href = '/cart'; }, 1200);
    } catch (error) {
      btn.innerHTML = 'Error';
      btn.style.background = '#dc3545';
      setTimeout(() => {
        btn.disabled = false;
        btn.innerHTML = orig;
        btn.style.background = '';
      }, 2000);
    }
  }

  async function downloadGeneratedImage() {
    const generatedImage = document.getElementById('vtl-result-image');
    if (!generatedImage || !generatedImage.src) return;
    const proxyUrl = 'https://seebeforebuy.in/api/download-image?url=' + encodeURIComponent(generatedImage.src);
    const a = document.createElement('a');
    a.href = proxyUrl;
    a.download = 'see-before-buy-preview.png';
    a.target = '_blank';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  async function shareResultImage() {
    const generatedImage = document.getElementById('vtl-result-image');
    if (!generatedImage || !generatedImage.src) {
      showVTLStatus('No generated try-on to share.', 'error');
      return;
    }

    if (navigator.share) {
      try {
        const response = await fetch(generatedImage.src);
        const blob = await response.blob();
        const file = new File([blob], 'virtual-tryon.png', { type: 'image/png' });
        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          await navigator.share({ files: [file], title: 'My Virtual Try-On', text: 'Check out my new look!' });
        } else {
          await navigator.share({ title: 'My Virtual Try-On', text: 'Check out my new look!', url: generatedImage.src });
        }
      } catch (error) {
        showVTLStatus('Sharing is unavailable right now.', 'error');
      }
    } else {
      showVTLStatus('Sharing is unavailable on this device.', 'error');
    }
  }

  function sendFeedback(type) {
    const btns = document.querySelectorAll('.vtl-rf-btn');
    btns.forEach((b) => (b.style.opacity = '0.4'));
    const sel = type === 'good' ? document.querySelector('.vtl-rf-good') : document.querySelector('.vtl-rf-btn:not(.vtl-rf-good)');
    if (sel) { sel.style.opacity = '1'; sel.style.borderColor = type === 'good' ? '#059669' : '#dc3545'; }
    showVTLStatus(type === 'good' ? 'Thanks for your feedback!' : 'Sorry about that. Try with a different photo.', type === 'good' ? 'success' : 'error');
    setTimeout(hideVTLStatus, 3000);
  }

  function showVTLStatus(msg, type) {
    const el = document.getElementById('vtl-status');
    if (!el) return;
    el.textContent = msg;
    el.className = 'vtl-status-msg ' + type;
    el.style.display = 'block';
  }

  function hideVTLStatus() {
    const el = document.getElementById('vtl-status');
    if (el) {
      el.style.display = 'none';
      el.className = 'vtl-status-msg';
    }
  }

  function clearAllTimers() {
    screenTimers.forEach((t) => clearTimeout(t));
    screenTimers = [];
    stopTipRotation();
  }

  function resetForm() {
    clearAllTimers();
    selectedImageFile = null;
    userImageDataURL = null;
    currentRequestPromise = null;
    document.getElementById('vtl-preview-wrap').style.display = 'none';
    document.getElementById('vtl-preview-img').src = '';
    document.getElementById('vtl-preview-name').textContent = '';
    document.getElementById('vtl-file-input').value = '';
    document.getElementById('vtl-upload-btn').style.display = 'flex';
    document.getElementById('vtl-generate-actions').style.display = 'none';
    document.getElementById('vtl-uploading-state').style.display = 'none';
    document.querySelector('.vtl-ready-label').style.display = '';
    document.querySelector('.vtl-product-strip').style.display = '';
    document.querySelector('.vtl-upload-tips').style.display = '';
    document.getElementById('vtl-result-image').src = '';
    document.getElementById('vtl-download-btn').href = '#';
    ['vtl-cr1', 'vtl-cr2', 'vtl-cr3', 'vtl-cr4'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) { el.classList.remove('done', 'active'); el.classList.add('pending'); }
    });
    ['vtl-prog-fill-1', 'vtl-prog-fill-2', 'vtl-prog-fill-3', 'vtl-prog-fill-4'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.style.width = '0%';
    });
    document.querySelectorAll('.vtl-rf-btn').forEach((b) => { b.style.opacity = ''; b.style.borderColor = ''; });
    setVTLScreen(0);
    hideVTLStatus();
  }

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') closeVTLPopupDirect();
  });

  function adjustColor(color, percent) {
    if (!color) return '#329580';
    const clean = color.replace('#', '');
    const num = parseInt(clean, 16);
    const amt = Math.round(2.55 * percent);
    const R = (num >> 16) + amt;
    const G = (num >> 8 & 0x00FF) + amt;
    const B = (num & 0x0000FF) + amt;
    return '#' + (0x1000000 + (R < 255 ? R < 1 ? 0 : R : 255) * 0x10000 + (G < 255 ? G < 1 ? 0 : G : 255) * 0x100 + (B < 255 ? B < 1 ? 0 : B : 255)).toString(16).slice(1);
  }

  async function fetchAndApplySettings() {
    const shopDomain = window.Shopify?.shop || 'see-before-buy-ai.myshopify.com';
    const backendUrl = 'https://seebeforebuy.in';

    try {
      // Fetch settings and shop categories in parallel
      const [settingsRes, shopRes] = await Promise.all([
        fetch(`${backendUrl}/api/settings/${shopDomain}`),
        fetch(`${backendUrl}/api/shop-status/${shopDomain}`),
      ]);

      // Apply UI settings
      if (settingsRes.ok) {
        const settingsData = await settingsRes.json();
        if (settingsData.success && settingsData.settings) {
          applySettings(settingsData.settings);
        }
      }

      // Store shop's selected main categories for prompt detection
      if (shopRes.ok) {
        const shopData = await shopRes.json();
        const cats = shopData.shopStatus?.product_categories;
        if (Array.isArray(cats) && cats.length > 0) {
          // product_categories is stored as [{main_category: "indo_western"}, ...]
          // or as a flat array of strings — handle both
          sbbShopCategories = cats.map(c =>
            typeof c === 'string' ? c : (c.main_category || c)
          ).filter(Boolean);
        }
        // Update the product category label in the popup
        if (sbbShopCategories.length > 0 && window.SBB_PROMPTS) {
          const firstCat = window.SBB_PROMPTS.PROMPT_CONFIG[sbbShopCategories[0]];
          if (firstCat && firstCat.label) {
            const catLabel = document.getElementById('vtl-product-cat-label');
            if (catLabel) catLabel.textContent = firstCat.label;
          }
        }
      }
    } catch (error) {
      console.warn('Unable to load SBB settings:', error);
    }
  }

  function applySettings(settings) {
    if (!settings) return;
    const root = document.documentElement;

    // ── Trigger button ──────────────────────────────────────
    if (settings.button) {
      root.style.setProperty('--vtl-trigger-bg', settings.button.bg_color || '#111');
      root.style.setProperty('--vtl-trigger-color', settings.button.text_color || '#fff');
      root.style.setProperty('--vtl-trigger-radius', `${settings.button.border_radius ?? 14}px`);
      const label = document.getElementById('vtl-trigger-btn-label');
      if (label && settings.button.text) label.textContent = settings.button.text;
    }

    // ── Popup & header ──────────────────────────────────────
    if (settings.popup) {
      root.style.setProperty('--vtl-header-bg', settings.popup.header_bg_color || '#fff');
      root.style.setProperty('--vtl-header-color', settings.popup.header_bg_color ? '#fff' : '#111');
      root.style.setProperty('--vtl-modal-bg', settings.popup.bg_color || '#fff');
      root.style.setProperty('--vtl-modal-color', settings.popup.text_color || '#111');
      root.style.setProperty('--vtl-modal-radius', `${settings.popup.border_radius ?? 28}px`);
      root.style.setProperty('--vtl-upload-area-bg', settings.popup.upload_area_bg_color || '#f8f9fa');
      root.style.setProperty('--vtl-upload-btn-bg', settings.popup.upload_btn_bg_color || '#008060');
      root.style.setProperty('--vtl-upload-btn-color', settings.popup.upload_btn_text_color || '#fff');
      root.style.setProperty('--vtl-generate-btn-bg', settings.popup.generate_btn_bg_color || '#008060');
      root.style.setProperty('--vtl-generate-btn-color', settings.popup.generate_btn_text_color || '#fff');

      const headerTitle = document.getElementById('vtl-header-title');
      if (headerTitle && settings.popup.title) headerTitle.textContent = settings.popup.title;
      const uploadLabel = document.getElementById('vtl-upload-btn-label');
      if (uploadLabel && settings.popup.upload_button_text) uploadLabel.textContent = settings.popup.upload_button_text;
      const generateLabel = document.getElementById('vtl-generate-btn-label');
      if (generateLabel && settings.popup.generate_button_text) generateLabel.textContent = settings.popup.generate_button_text;
    }

    // ── Add to Cart button ──────────────────────────────────
    if (settings.add_to_cart_button) {
      root.style.setProperty('--vtl-atc-btn-bg', settings.add_to_cart_button.bg_color || '#111');
      root.style.setProperty('--vtl-atc-btn-color', settings.add_to_cart_button.text_color || '#fff');
      root.style.setProperty('--vtl-atc-btn-radius', `${settings.add_to_cart_button.border_radius ?? 12}px`);
      const atcLabel = document.getElementById('vtl-add-to-cart-btn-label');
      if (atcLabel && settings.add_to_cart_button.text) atcLabel.textContent = settings.add_to_cart_button.text;
    }
  }

  window.openVTLPopup = openVTLPopup;
  window.closeVTLPopup = closeVTLPopup;
  window.closeVTLPopupDirect = closeVTLPopupDirect;
  window.goBackFromResult = goBackFromResult;
  window.handleVTLUpload = handleVTLUpload;
  window.removeVTLImage = removeVTLImage;
  window.onGenerateClick = onGenerateClick;
  window.addToCart = addToCart;
  window.downloadGeneratedImage = downloadGeneratedImage;
  window.shareResultImage = shareResultImage;
  window.resetAndGoBack = resetAndGoBack;

  document.addEventListener('DOMContentLoaded', function () {
    const popup = document.getElementById('vtl-popup');
    if (popup && popup.parentNode !== document.body) document.body.appendChild(popup);
    setVTLScreen(0);
    // Fetch settings AFTER popup is in body so element lookups work
    fetchAndApplySettings();
  });
</script>

{% endif %}

