<!-- Try the Look Button and Popup -->
{% assign current_product = block.settings.product %}
{% assign default_variant = current_product.selected_or_first_available_variant %}

{% if current_product %}
<div class="vtl-trigger-wrap">
  <button class="vtl-trigger-btn" onclick="openVTLPopup()" type="button">
    <span id="vtl-trigger-btn-label">Try The Look</span>
  </button>
</div>

<div id="vtl-popup" class="vtl-overlay" onclick="closeVTLPopup(event)">
  <div class="vtl-modal" onclick="event.stopPropagation()">
    <div class="vtl-header">
      <button class="vtl-header-back" id="vtl-back-btn" onclick="goBackFromResult()" type="button" aria-label="Back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
      <div class="vtl-header-center">
        <div class="vtl-header-title" id="vtl-header-title">Try The Look</div>
        <div class="vtl-header-sub" id="vtl-header-sub">See how it looks on you</div>
      </div>
      <button class="vtl-header-close" onclick="closeVTLPopupDirect()" type="button" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="vtl-screen active" id="vtl-s0">
      <div class="vtl-product-strip">
        {% if current_product and current_product.featured_image %}
          <img src="{{ current_product.featured_image | image_url: width: 160 }}" alt="{{ current_product.title | escape }}" class="vtl-product-thumb" width="64" height="80">
        {% else %}
          <div class="vtl-product-thumb-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24">
              <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>
            </svg>
          </div>
        {% endif %}
        <div class="vtl-product-meta">
          <div class="vtl-product-name">{{ current_product.title }}</div>
          <div class="vtl-product-cat">Virtual try-on &middot; <strong id="vtl-product-cat-label" style="text-transform:capitalize; color:#008060;">AI Try-On</strong></div>
        </div>
      </div>

      <div class="vtl-ready-label">
        <div class="vtl-badge">AI Preview</div>
        <h3 class="vtl-ready-title">See it on you in seconds</h3>
        <p class="vtl-ready-sub">Upload a clear photo and we’ll create a live preview of how this product looks on you.</p>
      </div>

      <div class="vtl-upload-card">
        <input type="file" id="vtl-file-input" accept="image/*" style="display:none;" onchange="handleVTLUpload(event)">
        <button class="vtl-btn-primary vtl-btn-teal" id="vtl-upload-btn" type="button" onclick="document.getElementById('vtl-file-input').click()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          <span id="vtl-upload-btn-label">Choose Your Photo</span>
        </button>
        <div class="vtl-upload-hint">PNG or JPG • clear light • full body works best</div>
      </div>

      <div class="vtl-preview-wrap" id="vtl-preview-wrap" style="display:none;">
        <div class="vtl-preview-card">
          <img id="vtl-preview-img" src="" alt="Your photo" class="vtl-preview-img">
          <button class="vtl-preview-remove" onclick="removeVTLImage(event)" type="button" aria-label="Remove">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
        <div class="vtl-preview-name" id="vtl-preview-name"></div>
      </div>

      <div class="vtl-generate-actions" id="vtl-generate-actions" style="display:none;">
        <button class="vtl-btn-primary vtl-btn-teal" id="vtl-generate-btn" type="button" onclick="onGenerateClick()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
          </svg>
          <span id="vtl-generate-btn-label">Generate Preview</span>
        </button>
      </div>

      <div class="vtl-uploading-state" id="vtl-uploading-state" style="display:none;">
        <div class="vtl-uploading-spinner"></div>
        <div class="vtl-uploading-text">Preparing your preview...</div>
      </div>

      <div class="vtl-upload-tips">
        <div class="vtl-tips-title">Tips for best results</div>
        <div class="vtl-tips-grid">
          <div class="vtl-tip-item">Full body photo</div>
          <div class="vtl-tip-item">Good lighting</div>
          <div class="vtl-tip-item">Stand straight</div>
          <div class="vtl-tip-item">Front-facing angle</div>
        </div>
      </div>

      <div class="vtl-terms">Your photo is processed securely and used to generate your preview.</div>
    </div>

    <div class="vtl-screen" id="vtl-s1">
      <div class="vtl-loading-screen">
        <div class="vtl-badge vtl-badge-soft">Smart Preview</div>
        <div class="vtl-cards-visual">
          <div class="vtl-cv-card vtl-cv-product"><img id="vtl-card-product-img-1" src="" alt="Product" class="vtl-cv-card-img"></div>
          <div class="vtl-cv-card vtl-cv-user"><img id="vtl-card-user-img-1" src="" alt="You" class="vtl-cv-card-img"></div>
          <div class="vtl-cv-sync"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg></div>
        </div>
        <div class="vtl-stage-text">
          <div class="vtl-stage-title" id="vtl-s1-title">Analyzing your photo...</div>
          <div class="vtl-stage-sub" id="vtl-s1-sub">Checking posture, lighting, and pose</div>
        </div>
        <div class="vtl-progress-wrap"><div class="vtl-progress-track"><div class="vtl-progress-fill" id="vtl-prog-fill-1"></div></div><div class="vtl-progress-pct" id="vtl-prog-pct-1">0%</div></div>
        <div class="vtl-tip-card"><div class="vtl-tip-label">Working on</div><div class="vtl-tip-text" id="vtl-tip-text-1">A better preview is being prepared for you.</div></div>
      </div>
    </div>

    <div class="vtl-screen" id="vtl-s2">
      <div class="vtl-loading-screen">
        <div class="vtl-badge vtl-badge-soft">Matching product</div>
        <div class="vtl-cards-visual">
          <div class="vtl-cv-card vtl-cv-product"><img id="vtl-card-product-img-2" src="" alt="Product" class="vtl-cv-card-img"></div>
          <div class="vtl-cv-card vtl-cv-user"><img id="vtl-card-user-img-2" src="" alt="You" class="vtl-cv-card-img"></div>
          <div class="vtl-cv-sync"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg></div>
        </div>
        <div class="vtl-stage-text"><div class="vtl-stage-title">Reading garment details...</div><div class="vtl-stage-sub">Mapping fabric, colour, and structure</div></div>
        <div class="vtl-progress-wrap"><div class="vtl-progress-track"><div class="vtl-progress-fill" id="vtl-prog-fill-2"></div></div><div class="vtl-progress-pct" id="vtl-prog-pct-2">38%</div></div>
        <div class="vtl-tip-card"><div class="vtl-tip-label">Tip</div><div class="vtl-tip-text" id="vtl-tip-text-2">Stand straight with arms slightly away from your body.</div></div>
      </div>
    </div>

    <div class="vtl-screen" id="vtl-s3">
      <div class="vtl-loading-screen">
        <div class="vtl-badge vtl-badge-soft">Placing the look</div>
        <div class="vtl-cards-visual">
          <div class="vtl-cv-card vtl-cv-product"><img id="vtl-card-product-img-3" src="" alt="Product" class="vtl-cv-card-img"></div>
          <div class="vtl-cv-card vtl-cv-user"><img id="vtl-card-user-img-3" src="" alt="You" class="vtl-cv-card-img"></div>
          <div class="vtl-cv-sync"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg></div>
        </div>
        <div class="vtl-stage-text"><div class="vtl-stage-title">Placing it on you...</div><div class="vtl-stage-sub">Matching lighting, shadows, and fit</div></div>
        <div class="vtl-progress-wrap"><div class="vtl-progress-track"><div class="vtl-progress-fill" id="vtl-prog-fill-3"></div></div><div class="vtl-progress-pct" id="vtl-prog-pct-3">65%</div></div>
        <div class="vtl-tip-card"><div class="vtl-tip-label">Tip</div><div class="vtl-tip-text" id="vtl-tip-text-3">Avoid extreme angles — a straight-on mirror selfie works best.</div></div>
      </div>
    </div>

    <div class="vtl-screen" id="vtl-s4">
      <div class="vtl-loading-screen vtl-loading-screen-checklist">
        <div class="vtl-badge vtl-badge-soft">Finishing up</div>
        <div class="vtl-cards-visual" style="margin-top:24px;">
          <div class="vtl-cv-card vtl-cv-product"><img id="vtl-card-product-img-4" src="" alt="Product" class="vtl-cv-card-img"></div>
          <div class="vtl-cv-card vtl-cv-user"><img id="vtl-card-user-img-4" src="" alt="You" class="vtl-cv-card-img"></div>
          <div class="vtl-cv-sync"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg></div>
        </div>
        <div class="vtl-stage-text"><div class="vtl-stage-title">Finalizing the look...</div><div class="vtl-stage-sub">Quality check in progress</div></div>
        <div class="vtl-progress-wrap"><div class="vtl-progress-track"><div class="vtl-progress-fill" id="vtl-prog-fill-4" style="width:82%"></div></div><div class="vtl-progress-pct" id="vtl-prog-pct-4">82%</div></div>
        <div class="vtl-checklist">
          <div class="vtl-check-row" id="vtl-cr1"><div class="vtl-cr-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg></div><div class="vtl-cr-text"><div class="vtl-cr-label">Lighting matched</div><div class="vtl-cr-desc">Ambient light blended</div></div><div class="vtl-cr-badge">done</div></div>
          <div class="vtl-check-row" id="vtl-cr2"><div class="vtl-cr-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg></div><div class="vtl-cr-text"><div class="vtl-cr-label">Fabric texture applied</div><div class="vtl-cr-desc">Folds and weight rendered</div></div><div class="vtl-cr-badge">done</div></div>
          <div class="vtl-check-row" id="vtl-cr3"><div class="vtl-cr-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg></div><div class="vtl-cr-text"><div class="vtl-cr-label">Shadow depth set</div><div class="vtl-cr-desc">Natural shadows added</div></div><div class="vtl-cr-badge">done</div></div>
          <div class="vtl-check-row" id="vtl-cr4"><div class="vtl-cr-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg></div><div class="vtl-cr-text"><div class="vtl-cr-label">Face preserved</div><div class="vtl-cr-desc">Confirming face is unchanged</div></div><div class="vtl-cr-badge">done</div></div>
        </div>
      </div>
    </div>

    <div class="vtl-screen" id="vtl-s5">
      <div class="vtl-result-full">
        <div class="vtl-result-header">
          <div>
            <div class="vtl-result-title">Your Try-On</div>
            <div class="vtl-result-sub" id="vtl-result-timer"></div>
          </div>
          <div class="vtl-result-header-close" onclick="closeVTLPopupDirect()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </div>
        </div>
        <div class="vtl-result-image-area" id="vtl-result-image-area">
          <img id="vtl-result-image" src="" alt="AI Try-On Result" class="vtl-result-img">
          <div class="vtl-result-pip" id="vtl-result-pip">
            {% if current_product and current_product.featured_image %}
              <img src="{{ current_product.featured_image | image_url: width: 160 }}" alt="{{ current_product.title | escape }}" class="vtl-pip-img">
            {% endif %}
          </div>
        </div>
        <div class="vtl-result-sheet">
          <div class="vtl-result-sheet-handle"></div>
          <div class="vtl-result-product-row">
            <div class="vtl-rpr-name">{{ current_product.title }}</div>
          </div>
          <div class="vtl-result-actions">
            <button class="vtl-ra-btn-primary" id="vtl-add-to-cart-btn" onclick="addToCart()" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              <span id="vtl-add-to-cart-btn-label">Add to Cart</span>
            </button>
            <a id="vtl-download-btn" class="vtl-ra-btn-icon" href="#" download="my-ai-tryon.png" aria-label="Download" onclick="downloadGeneratedImage()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            </a>
            <button class="vtl-ra-btn-icon" onclick="shareResultImage()" type="button" aria-label="Share">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </button>
          </div>
          <div class="vtl-result-feedback">
            <div class="vtl-rf-label">Preview ready</div>
            <button class="vtl-rf-retry" onclick="resetAndGoBack()" type="button">Try another photo</button>
          </div>
        </div>
      </div>
    </div>

    <div id="vtl-status" class="vtl-status-msg"></div>
  </div>
</div>

<input type="hidden" id="sbb-variant-id" value="{{ default_variant.id }}">
<input type="hidden" id="sbb-product-title" value="{{ current_product.title | escape }}">

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

  :root {
    --vtl-teal: #008060;
    --vtl-teal-d: #005c45;
    --vtl-navy: #111827;
    --vtl-white: #fff;
    --vtl-mint: #EAF5EF;
    --vtl-gray: #F6F6F7;
    --vtl-border: #E5E7EB;
    --vtl-muted: #6B7280;
    --vtl-green: #059669;
    --vtl-green-bg: #D1FAE5;
    --vtl-trigger-bg: #111;
    --vtl-trigger-color: #fff;
    --vtl-trigger-radius: 14px;
    --vtl-modal-bg: #fff;
    --vtl-modal-color: #111;
    --vtl-modal-radius: 28px;
    --vtl-header-bg: #fff;
    --vtl-header-color: #111;
    --vtl-header-sub-color: #6B7280;
    --vtl-upload-area-bg: #f8f9fa;
    --vtl-upload-btn-bg: #008060;
    --vtl-upload-btn-color: #fff;
    --vtl-generate-btn-bg: #008060;
    --vtl-generate-btn-color: #fff;
    --vtl-atc-btn-bg: #111;
    --vtl-atc-btn-color: #fff;
    --vtl-atc-btn-radius: 12px;
  }

  .vtl-trigger-wrap { margin: 20px 0; }
  .vtl-trigger-btn {
    width: 100%; padding: 14px 24px; font-family: 'Poppins', -apple-system, sans-serif;
    font-size: 15px; font-weight: 700; background: var(--vtl-trigger-bg); color: var(--vtl-trigger-color); border: none;
    border-radius: var(--vtl-trigger-radius); cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px;
    transition: all 0.2s ease; box-shadow: 0 4px 14px rgba(0,0,0,0.15);
  }
  .vtl-trigger-btn:hover { background: color-mix(in srgb, var(--vtl-trigger-bg) 85%, black); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(0,0,0,0.2); }
  .vtl-trigger-icon { width: 20px; height: 20px; }

  .vtl-overlay {
    display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    width: 100vw; height: 100vh; background-color: rgba(0,0,0,0.75); backdrop-filter: blur(8px);
    z-index: 9999999 !important; padding: 16px; box-sizing: border-box; align-items: center; justify-content: center;
  }
  .vtl-overlay.active { display: flex !important; }

  .vtl-modal {
    background: var(--vtl-modal-bg); color: var(--vtl-modal-color); border-radius: var(--vtl-modal-radius); width: 100%; max-width: 440px; position: relative; margin: 0 auto;
    animation: vtl-slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    display: flex; flex-direction: column; max-height: calc(100vh - 40px); overflow: hidden;
  }
  @keyframes vtl-slideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

  .vtl-header {
    display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid #f0f0f0;
    background: var(--vtl-header-bg); color: var(--vtl-header-color); flex-shrink: 0; position: relative; z-index: 20;
  }
  .vtl-header-back, .vtl-header-close {
    width: 34px; height: 34px; border-radius: 50%; background: var(--vtl-gray); border: none;
    display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--vtl-navy); transition: all 0.2s;
  }
  .vtl-header-back svg, .vtl-header-close svg { width: 16px; height: 16px; }
  .vtl-header-back { opacity: 0; pointer-events: none; }
  .vtl-header-back.visible { opacity: 1; pointer-events: all; }
  .vtl-header-close { color: var(--vtl-muted); }
  .vtl-header-close:hover { background: #eee; }
  .vtl-header-center { text-align: center; }
  .vtl-header-title { font-family: 'Poppins', -apple-system, sans-serif; font-size: 15px; font-weight: 800; color: var(--vtl-header-color); line-height: 1.2; }
  .vtl-header-sub { font-family: 'Poppins', -apple-system, sans-serif; font-size: 10px; color: var(--vtl-header-sub-color); margin-top: 1px; }

  .vtl-screen {
    position: absolute; top: 68px; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column;
    opacity: 0; pointer-events: none; transition: opacity 0.25s ease; background: #fff; overflow-y: auto; overflow-x: hidden;
  }
  .vtl-screen.active { opacity: 1; pointer-events: all; position: relative; top: auto; }

  .vtl-product-strip { margin: 16px 18px 0; background: #f8f9fa; border-radius: 16px; padding: 14px 16px; display: flex; align-items: center; gap: 14px; border: 1px solid var(--vtl-border); }
  .vtl-product-thumb { width: 56px; height: 70px; border-radius: 12px; object-fit: cover; flex-shrink: 0; border: 1px solid var(--vtl-border); }
  .vtl-product-thumb-placeholder { width: 56px; height: 70px; border-radius: 12px; background: linear-gradient(135deg, #f0f4ff, var(--vtl-mint)); display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid var(--vtl-border); color: var(--vtl-muted); }
  .vtl-product-meta { flex: 1; }
  .vtl-product-name { font-family: 'Poppins', -apple-system, sans-serif; font-size: 13px; font-weight: 700; color: #111; margin-bottom: 3px; line-height: 1.3; }
  .vtl-product-cat { font-family: 'Poppins', -apple-system, sans-serif; font-size: 11px; color: var(--vtl-muted); }

  .vtl-ready-label { text-align: center; padding: 24px 18px 0; }
  .vtl-ready-title { font-family: 'Poppins', -apple-system, sans-serif; font-size: 22px; font-weight: 800; color: #111; margin-bottom: 6px; letter-spacing: -0.02em; }
  .vtl-ready-sub { font-family: 'Poppins', -apple-system, sans-serif; font-size: 12px; color: var(--vtl-muted); line-height: 1.5; }
  .vtl-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 10px;
    border-radius: 999px;
